diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 7f454b1..504c341 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -37,6 +37,12 @@ constexpr const char* SETTING_VIDEOSCREEN_COLORRANGE = "videoscreen.colorrange";
 // amdgpu drm driver needs at least 1 primary plane to active when doing a modeset
 inline constexpr int QUIRK_NEEDSPRIMARY = 1 << 0;
 
+// rockchip vop2 exposes exactly one smart (scaling) primary plane, and on a 4K
+// mode it is the only plane able to scan the whole frame out. The gui only needs
+// a cluster plane, so keep the primary plane free for direct-to-plane video and
+// fall back to the primary plane only when nothing else can host the gui.
+inline constexpr int QUIRK_GUI_PREFER_OVERLAY = 1 << 1;
+
